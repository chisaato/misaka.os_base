# 自建 systemd 测试镜像，保持与 Podman Fedora 场景一致。
FROM {{ item.image }}

ENV container=docker

RUN dnf -y install \
        systemd \
        python3 \
        python3-libdnf5 \
        sudo \
        iproute \
        procps-ng \
    && dnf clean all \
    && ln -sf /dev/null /etc/systemd/system/getty.target

CMD ["/sbin/init"]
