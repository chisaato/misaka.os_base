# {{ ansible_managed }}
[Journal]
Storage={{ logging_journald_storage }}
Compress={{ logging_journald_compress | bool | ternary('yes', 'no') }}
SystemMaxUse={{ logging_journald_system_max_use }}
SystemKeepFree={{ logging_journald_system_keep_free }}
RuntimeMaxUse={{ logging_journald_runtime_max_use }}
MaxRetentionSec={{ logging_journald_max_retention_sec }}
MaxFileSec={{ logging_journald_max_file_sec }}
SyncIntervalSec={{ logging_journald_sync_interval_sec }}
ForwardToSyslog={{ logging_journald_forward_to_syslog | bool | ternary('yes', 'no') }}
