{% for mirror in debian_repo_mirror_list %}
deb-src https://{{ mirror }}/debian/ {{ debian_repo_target_codename }}-updates main contrib non-free {% if debian_repo_target_major_version is version('12', '>=') %}non-free-firmware{% endif +%}
{% endfor %}
# 反向移植源 src
{% for mirror in debian_repo_mirror_list %}
deb-src https://{{ mirror }}/debian/ {{ debian_repo_target_codename }}-backports main contrib non-free {% if debian_repo_target_major_version is version('12', '>=') %}non-free-firmware{% endif +%}
{% endfor %}
# 安全更新源 src
{% for mirror in debian_repo_mirror_list %}
deb-src https://{{ mirror }}/debian-security {{ debian_repo_target_codename }}/updates main contrib non-free {% if debian_repo_target_major_version is version('12', '>=') %}non-free-firmware{% endif +%}
{% endfor %}

