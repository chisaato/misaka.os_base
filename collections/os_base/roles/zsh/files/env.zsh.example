#!/bin/zsh
# SYNOPSIS: field_prepend varName fieldVal [sep]
#   SEP defaults to ':'
# Note: Forces fieldVal into the first position, if already present.
#       Duplicates are removed, too.
# EXAMPLE: field_prepend PATH /usr/local/bin
field_prepend() {
    # set -x
    local varName=$1 fieldVal=$2 IFS=${3:-':'} auxArr
    # 先用 (P) 作为变量名展开
    # 再用 (@s/:/) 以 : 分割数组
    auxArr=("${(s/:/)${(P)varName}}")
    # echo "$fieldVal"
    # print -rl -- ${(t)auxArr}
    for ((i = 1; i < ${#auxArr}; i++));do
        # echo $i
        [[ ${auxArr[i]} == "$fieldVal" ]] && auxArr=($auxArr[1,$i-1] $auxArr[$i+1,-1])
    done
    auxArr=("$fieldVal" "${auxArr[@]}")
    printf -v "$varName" '%s' "${auxArr[*]}"
    # set +x
}

# SYNOPSIS: field_append varName fieldVal [sep]
#   SEP defaults to ':'
# Note: Forces fieldVal into the last position, if already present.
#       Duplicates are removed, too.
# EXAMPLE: field_append PATH /usr/local/bin
field_append() {
    local varName=$1 fieldVal=$2 IFS=${3:-':'} auxArr
    # 先用 (P) 作为变量名展开
    # 再用 (@s/:/) 以 : 分割数组
    auxArr=("${(s/:/)${(P)varName}}")
    # echo "$fieldVal"
    # print -rl -- ${(t)auxArr}
    for ((i = 1; i < ${#auxArr}; i++));do
        # echo $i
        [[ ${auxArr[i]} == "$fieldVal" ]] && auxArr=($auxArr[1,$i-1] $auxArr[$i+1,-1])
    done
    auxArr+=("$fieldVal")
    printf -v "$varName" '%s' "${auxArr[*]}"
}

# SYNOPSIS: field_remove varName fieldVal [sep]
#   SEP defaults to ':'
# Note: Duplicates are removed, too.
# EXAMPLE: field_remove PATH /usr/local/bin
field_remove() {
    local varName=$1 fieldVal=$2 IFS=${3:-':'} auxArr
    # 先用 (P) 作为变量名展开
    # 再用 (@s/:/) 以 : 分割数组
    auxArr=("${(s/:/)${(P)varName}}")
    # echo "$fieldVal"
    # print -rl -- ${(t)auxArr}
    for ((i = 1; i < ${#auxArr}; i++));do
        # echo $i
        [[ ${auxArr[i]} == "$fieldVal" ]] && auxArr=($auxArr[1,$i-1] $auxArr[$i+1,-1])
    done
    printf -v "$varName" '%s' "${auxArr[*]}"
}
#禁用转义
export DISABLE_MAGIC_FUNCTIONS=true
# 所有语言的依赖
export ALL_PACKAGE_HOME=/data/.buildTools

# Ruby
export RUBY_BUILD_MIRROR_URL=https://cache.ruby-china.com
export RUBY_BUILD_MIRROR_PACKAGE_URL=https://gems.ruby-china.com

# Golang
# Golang 模块代理
export GO111MODULE=on
# export GOPROXY=https://mirrors.aliyun.com/goproxy/
# export GOPROXY=https://mirrors.cloud.tencent.com/go/
#export GOPROXY=https://goproxy.cn,https://goproxy.bj.bcebos.com,https://goproxy.io,direct
export GOPROXY=https://goproxy.cn,https://mirrors.cloud.tencent.com/go,https://goproxy.bj.bcebos.com,https://gocenter.io,https://goproxy.io,direct
export GOPATH=${ALL_PACKAGE_HOME}/go
# export PATH=$GOPATH/bin${PATH:+:${PATH}}
field_prepend PATH $GOPATH/bin

# NodeJS
# 由于淘宝采用 JS 渲染页面,破坏了匹配分析版本号
# 这里改用替代镜像站
# 阿里貌似拦截 aria2 下载
# https://mirrors.aliyun.com/nodejs-release/
# https://mirrors.tencent.com/nodejs-release/
export NODEJS_ORG_MIRROR=https://mirrors.tencent.com/nodejs-release/
export NODE_BUILD_MIRROR_URL=https://mirrors.tencent.com/nodejs-release/
# Yarn 全局 bin
# export PATH=$HOME/.yarn/bin${PATH:+:${PATH}}
field_prepend PATH $HOME/.yarn/bin

# Java
export GRADLE_HOME=${ALL_PACKAGE_HOME}/gradle
export GRADLE_USER_HOME=${GRADLE_HOME}
export _JAVA_OPTIONS="-Dawt.useSystemAAFontSettings=on -Dswing.aatext=true -Dswing.defaultlaf=com.sun.java.swing.plaf.gtk.GTKLookAndFeel"
export SDKMAN_DIR=${HOME}/.sdkman

# CUDA
# export PATH=/usr/local/cuda/bin${PATH:+:${PATH}}
field_prepend PATH /usr/local/cuda/bin

# Elixir
export HEX_MIRROR="https://hexpm.upyun.com"
export HEX_CDN="https://hexpm.upyun.com"

# Android SDK
export ANDROID_SDK_ROOT=${ALL_PACKAGE_HOME}/Android
# export PATH=$ANDROID_SDK_ROOT/tools/bin${PATH:+:${PATH}}
# export PATH=$ANDROID_SDK_ROOT/platform-tools${PATH:+:${PATH}}
# export PATH=$ANDROID_SDK_ROOT/emulator${PATH:+:${PATH}}
# Android Repo
export REPO_URL='https://mirrors.tuna.tsinghua.edu.cn/git/git-repo'

# IPFS
export IPFS_PATH=/data/.ipfs

# Homebrew
HOMEBREW_MIRROR="mirrors.tuna.tsinghua.edu.cn"
export HOMEBREW_BREW_GIT_REMOTE="https://${HOMEBREW_MIRROR}/git/homebrew/brew.git"
export HOMEBREW_CORE_GIT_REMOTE="https://${HOMEBREW_MIRROR}/git/homebrew/homebrew-core.git"
export HOMEBREW_BOTTLE_DOMAIN="https://${HOMEBREW_MIRROR}/homebrew-bottles"
if [[ -d /home/linuxbrew/.linuxbrew ]]; then
    export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew";
    export HOMEBREW_CELLAR="/home/linuxbrew/.linuxbrew/Cellar";
    export HOMEBREW_REPOSITORY="/home/linuxbrew/.linuxbrew/Homebrew";
    # export PATH="${PATH:+:${PATH}}:/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin";
    field_append PATH "/home/linuxbrew/.linuxbrew/bin"
    field_append PATH "/home/linuxbrew/.linuxbrew/sbin"
    # export MANPATH="${MANPATH}:/home/linuxbrew/.linuxbrew/share/man";
    field_append MANPATH "/home/linuxbrew/.linuxbrew/share/man"
    export INFOPATH="${INFOPATH:-}:/home/linuxbrew/.linuxbrew/share/info";
    field_append INFOPATH "/home/linuxbrew/.linuxbrew/share/info"
fi

# TexLive
# export TEXTLIVE_DISTRO_VER=2021
# export PATH=$PATH:$HOME/.local/texlive/${TEXTLIVE_DISTRO_VER}/bin/x86_64-linux

# Perl
# export PERL_BASE="${HOME}/.perl"
