# PERL_MB_OPT="--install_base \"${PERL_BASE}\""; export PERL_MB_OPT;
# PERL_MM_OPT="INSTALL_BASE=${PERL_BASE}"; export PERL_MM_OPT;

# Rust
export RUSTUP_DIST_SERVER="https://rsproxy.cn"
