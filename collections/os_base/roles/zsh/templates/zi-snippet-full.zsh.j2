{% macro choose_github_mirror() %}
    {%- if host_geo.country is defined and host_geo.country == "cn" and zsh_github_repo_mirror_cn | default('') | length > 0 -%}
        {# 国内走镜像 #}
        {{- zsh_github_repo_mirror_cn -}}
    {%- else -%}
        {# 否则就是 GitHub #}
        {{- "github.com" -}}
    {% endif %}
{% endmacro %}
{% macro choose_gitlab_mirror() %}
    {%- set gl_mirror = zsh_gitlab_repo_mirror_cn | default(gitlab_repo_zsh_mirror_cn | default('')) -%}
    {%- if host_geo.country is defined and host_geo.country == "cn" and gl_mirror | length > 0 -%}
        {# 国内走代理 #}
        {{- gl_mirror -}}
    {%- else -%}
        {# 否则就是 GitLab #}
        {{- "gitlab.com" -}}
    {% endif %}
{% endmacro %}

